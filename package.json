{
  "name": "towpath",
  "version": "0.1.0",
  "private": true,
  "description": "A relaxing top-down browser game about travelling the UK canals on a narrowboat.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
